# ShinaYuu Music 2.5.0 AI — do not commit real secrets
SHINAYUU_AI_PROVIDER=gemini
GEMINI_API_KEY=
SHINAYUU_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions
SHINAYUU_GEMINI_MODEL=gemini-3.7-flash

# Optional OpenAI fallback
SHINAYUU_AI_API_KEY=
SHINAYUU_AI_API_URL=https://api.openai.com/v1/responses
SHINAYUU_AI_MODEL=gpt-5.6

SHINAYUU_AI_WEB_SEARCH=true
SHINAYUU_AI_TOOL_CALLING=true
SHINAYUU_AI_MEMORY=true
SHINAYUU_AI_CACHE=true
SHINAYUU_AI_FAILOVER=true
SHINAYUU_AI_REASONING=high
SHINAYUU_AI_TIMEOUT_MS=25000
